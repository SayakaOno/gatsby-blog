---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Sidebar from '../../components/Sidebar';
import Page from '../../components/Page';
import siteMetadata from '../../data/siteMetadata.js';
import withSlash from '../../utils/with-slash';

export async function getStaticPaths() {
  const pages = await getCollection('pages');
  return pages.map(page => {
    const slug = page.id.replace(/\.md$/, '');
    return { params: { slug }, props: { entry: page } };
  });
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const slug = entry.id.replace(/\.md$/, '');
const language = slug.endsWith('/ja') ? 'ja' : 'en';
const siteSubtitle = language === 'en' ? siteMetadata.subtitle : siteMetadata.subtitleJa;
const title = entry.data.title;
const description = entry.data.description ?? siteSubtitle;

// Other language version: flip the /ja suffix, but only if that page exists.
// null disables the language switcher (e.g. contacts has no Japanese version).
const otherSlug = language === 'en' ? `${slug}/ja` : slug.replace(/\/ja$/, '');
const allPages = await getCollection('pages');
const otherExists = allPages.some(p => p.id.replace(/\.md$/, '') === otherSlug);
const otherLanguagePath = otherExists ? withSlash(`/pages/${otherSlug}`) : null;

const pathname = Astro.url.pathname;
---

<BaseLayout title={title} description={description} language={language} otherLanguagePath={otherLanguagePath}>
  <Sidebar
    client:load
    transition:persist="sidebar"
    siteMetadata={siteMetadata}
    pathname={pathname}
    otherLanguagePath={otherLanguagePath}
  />
  <Page client:load title={entry.data.title}>
    <Content />
  </Page>
</BaseLayout>
