---
import '../assets/scss/init.scss';
import siteMetadata from '../data/siteMetadata.js';
import { ClientRouter } from 'astro:transitions';
import ThemeSwitcher from '../components/Sidebar/ThemeSwitcher';

export interface Props {
  title?: string;
  description?: string;
  language?: 'en' | 'ja';
  otherLanguagePath?: string | null;
  ogType?: 'website' | 'article';
  image?: string | null;
}

const {
  title = siteMetadata.title,
  description = siteMetadata.subtitle,
  language = 'en',
  otherLanguagePath = null,
  ogType = 'website',
  image = null,
} = Astro.props;

const lang = language === 'ja' ? 'ja' : 'en';

// og:site_name is the name of the site, constant across every page — not the
// per-page title. Crawlers that render it (Discord, Slack) show it as the
// attribution line above the link.
const siteName = lang === 'ja' ? siteMetadata.titleJa : siteMetadata.title;
const gaId = siteMetadata.googleAnalyticsId;

// Pages build to directory URLs, so the canonical form always ends in a slash.
const canonical = new URL(Astro.url.pathname, siteMetadata.url);
if (!canonical.pathname.endsWith('/')) {
  canonical.pathname += '/';
}

// Social card images must be absolute URLs; crawlers don't resolve relative
// paths. Emitted only when a page actually supplies one, since pointing at a
// missing file gives a broken card rather than a text-only one.
const imageUrl = image ? new URL(image, siteMetadata.url).href : null;

// hreflang: tell Google the en/ja pages are translations of each other rather
// than duplicates. Only emitted where a counterpart page actually exists.
const otherUrl = otherLanguagePath
  ? new URL(otherLanguagePath, siteMetadata.url).href
  : null;
const alternates = otherUrl
  ? {
      en: language === 'en' ? canonical.href : otherUrl,
      ja: language === 'ja' ? canonical.href : otherUrl,
    }
  : null;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content={lang === 'ja' ? 'ja_JP' : 'en_US'} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <link rel="canonical" href={canonical.href} />
    {alternates && (
      <>
        <link rel="alternate" hreflang="en" href={alternates.en} />
        <link rel="alternate" hreflang="ja" href={alternates.ja} />
        <link rel="alternate" hreflang="x-default" href={alternates.en} />
      </>
    )}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/css/prismjs/theme.min.css" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      function applyTheme() {
        const stored = localStorage.getItem('theme');
        const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', stored ?? (prefersDark ? 'dark' : 'light'));
      }
      applyTheme();
      document.addEventListener('astro:after-swap', applyTheme);
    </script>
    <ClientRouter />
    <!-- Google Analytics -->
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
    <script define:vars={{ gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </head>
  <body>
    <ThemeSwitcher client:load />
    <div class="layout">
      <slot />
    </div>
    <!-- On first visit, redirect to /ja if browser language is Japanese -->
    <script>
      if (!sessionStorage.getItem('visited')) {
        sessionStorage.setItem('visited', 'true');
        const browserLang = navigator.language || (navigator as any).userLanguage;
        if (browserLang === 'ja' && !location.pathname.startsWith('/ja')) {
          location.href = '/ja/';
        }
      }
    </script>
  </body>
</html>

<style lang="scss">
  @use '../assets/scss/variables' as variables;

  .layout {
    lost-center: variables.$layout-width;
    max-width: variables.$layout-max-width;
    margin-left: auto;
    margin-right: auto;
  }
</style>
